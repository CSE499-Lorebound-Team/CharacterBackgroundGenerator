{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Auth": {
    "RequireConfirmedEmail": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
